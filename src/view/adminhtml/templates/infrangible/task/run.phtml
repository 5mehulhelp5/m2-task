use Infrangible\Task\Block\Adminhtml\Run\View;
use Magento\Framework\Escaper;

/** @var View $block */
/** @var Escaper $escaper */

$content = $block->getContent();
$errorContent = $block->getErrorContent();
?>
<div class="page-main-actions">
    <div class="page-actions">
        <div class="page-actions-buttons">
            <?= /* @noEscape */ $block->getBackButtonHtml() ?>
        </div>
    </div>
</div>

<h3><?= $escaper->escapeHtml($block->getLogFileName()) ?></h3>
<div class="task-log">
    <?php foreach ($content as $line): ?>
        <div><?= $escaper->escapeHtml($line) ?></div>
    <?php endforeach; ?>
</div>

<?php if (count($errorContent) > 0): ?>
    <h3 class="task-log-title"><?= $escaper->escapeHtml($block->getErrorFileName()) ?></h3>
    <div class="task-log">
        <?php foreach ($errorContent as $line): ?>
            <div><?= $escaper->escapeHtml($line) ?></div>
        <?php endforeach; ?>
    </div>
<?php endif; ?>
