use Infrangible\Task\Logger\Record;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Psr\Log\LogLevel;

/** @var Template $block */
/** @var Escaper $escaper */

$result = $block->getData('result');
$title = $block->getData('title');
?>
<h2><?= $escaper->escapeHtml(is_scalar($title) || $title instanceof Stringable ? (string)$title : '') ?></h2>
<div class="task-log">
    <?php foreach (is_array($result) ? $result : [] as $record): ?>
        <?php if ($record instanceof Record): ?>
            <?php $level = strtolower($record->getLevel()) ?>
            <?php $errorLevels = [LogLevel::EMERGENCY, LogLevel::ALERT, LogLevel::CRITICAL, LogLevel::ERROR] ?>
            <?php $class = in_array($level, $errorLevels, true) ? 'task-log-error' :
                ($level === LogLevel::WARNING ? 'task-log-warning' : 'task-log-info') ?>
            <div class="<?= /* @noEscape */ $class ?>"><?= $escaper->escapeHtml(trim($record->getMessage())) ?></div>
        <?php endif; ?>
    <?php endforeach; ?>
</div>
